@PointClass size(-4 -4 -4, 4 4 4) = ChoreoPlayer : "Choreo Player"
[
    "Scene Path" : string : "Scene Path" : ""
]

// ---------------------------------------------------------------------------
// Physics
// ---------------------------------------------------------------------------

@PointClass size(-4 -4 -4, 4 4 4) color(255 160 160) = PhysicsAnchorEntity : "Physics Anchor"
[
]

@PointClass size(-4 -4 -4, 4 4 4) color(255 160 160) = FixedConstraintEntity : "Fixed Constraint"
[
]

@PointClass size(-4 -4 -4, 4 4 4) color(255 160 160) = PointConstraintEntity : "Point Constraint"
[
]

@PointClass size(-4 -4 -4, 4 4 4) color(255 160 160) = SpringConstraintEntity : "Spring Constraint"
[
    "Auto Max Distance" : choices : "Auto Max Distance" : 1 =
    [
        0 : "No"
        1 : "Yes"
    ]
    "Min Distance" : string : "Min Distance" : "0"
    "Max Distance" : string : "Max Distance" : "0"
    "Damping" : string : "Damping" : "0.5"
    "Frequency" : string : "Frequency" : "1"
]

@PointClass size(-4 -4 -4, 4 4 4) color(255 160 160) = RopeObject : "Rope"
[
    "Segment Count" : string : "Segment Count" : "8"
]

