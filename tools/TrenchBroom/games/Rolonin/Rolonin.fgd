// Brush entities
// ---------------------------------------------------------------------------

@SolidClass = FuncDetail : "Detail geometry (merged, doesn't cut visibility)"
[
]

@SolidClass = FuncDoor : "Door"
[
    "Open on Use" : choices : "Open on Use" : 1 =
    [
        0 : "No"
        1 : "Yes"
    ]
]

@SolidClass = FuncButton : "Button"
[
]

@SolidClass = FuncSliding : "Sliding brush"
[
]

@SolidClass = FuncPhysics : "Physics brush"
[
]

@SolidClass = FuncTrigger : "Trigger volume (fires repeatedly)"
[
]

@SolidClass = FuncTriggerOnce : "Trigger volume (fires once)"
[
]

@SolidClass = FuncTriggerAll : "Trigger volume (requires all activators)"
[
]
