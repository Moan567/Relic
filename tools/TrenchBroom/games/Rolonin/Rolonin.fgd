@PointClass size(-4 -4 -4, 4 4 4) color(200 255 255) = LogicTransitionLevel : "Logic Transition Level"
[
    "Destination Anchor" : string : "Destination Anchor" : ""
    "Clear Map Cache" : choices : "Clear Map Cache" : 0 =
    [
        0 : "No"
        1 : "Yes"
