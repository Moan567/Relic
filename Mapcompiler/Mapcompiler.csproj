<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Target windows to match Engine which uses Windows-specific packages -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Mapcompiler_0._01</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);compiler;ENABLE_BSP</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);ENABLE_BSP;compiler</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lovebirb.MonoGame.SkinnedMeshImporter" Version="1.0.4" />
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="MessagePack.Attributeless" Version="1.0.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RectpackSharp" Version="1.2.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="SimpleImageIO" Version="1.6.1" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <Import Project="..\Shared\ChiselSharedTypes\ChiselSharedTypes.projitems" Label="Shared" />

  <Import Project="..\Shared\ChiselEditorUtils\ChiselEditorUtils.projitems" Label="Shared" />

  <Import Project="..\Shared\ChiselModelTypes\ChiselModelTypes.projitems" Label="Shared" />

  <ItemGroup>
    <EmbeddedResource Include="Shaders\**\*.glsl" />
  </ItemGroup>

</Project>
